generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SISTEMAS DO SITE (Vips, Quests, Loja)
// ==========================================

model PendingCommand {
  id        Int      @id @default(autoincrement())
  command   String
  executed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id
  status      String   @default("PENDING")
  pixCode     String?  @db.Text
  qrCode      String?  @db.Text
  checkoutUrl String?  @db.Text
  price       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   
}

model VipOrder {
  id                String   @id @default(uuid())
  steamId           String
  status            String   @default("PENDING")
  durationDays      Int      @default(30) 
  vipGroup          String   @default("vip1")
  expiresAt         DateTime
  notifiedAdd       Boolean  @default(false)
  notifiedDel       Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([steamId])
}

model Session {
  session_id String @id @db.VarChar(128)
  expires    Int    @db.UnsignedInt
  data       String @db.MediumText

  @@map("session") 
}

model PlayerStats {
  steamId           String   @id 
  zombieDamage      Int      @default(0)
  bossDamage        Int      @default(0)
  playtimeMinutes   Int      @default(0)
  zombieTankDamage  Int      @default(0)
  humansInfected    Int      @default(0)
  roundsSurvived    Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model Quest {
  id              Int      @id @default(autoincrement())
  title           String  
  description     String  
  type            String   // 'ZOMBIE_DAMAGE', 'BOSS_DAMAGE', 'PLAYTIME'
  targetValue     Int     
  eventName       String?
  useridField     String? 
  conditions      Json?
  rewardCredits   Int      @default(0) 
  rewardItem      String?
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  playerQuests    PlayerQuest[]
}

model ServerAdmin {
  steamId   String   @id
  name      String?
  addedAt   DateTime @default(now())
}

model PlayerQuest {
  id              Int      @id @default(autoincrement())
  steamId         String
  questId         Int
  progress        Int      @default(0)
  status          String   @default("IN_PROGRESS") // 'IN_PROGRESS', 'COMPLETED', 'CLAIMED', 'PENDING_DELIVERY'
  updatedAt       DateTime @updatedAt

  quest           Quest    @relation(fields: [questId], references: [id])
  
  @@unique([steamId, questId])
}

model QuestTemplate {
  id              String   @id @default(uuid())
  tier            String   
  type            String   
  eventName       String?
  useridField     String?
  titles          Json     
  descriptions    Json     
  minTarget       Int      
  maxTarget       Int      
  minReward       Int      
  maxReward       Int      
  baseConditions  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// INVENTÁRIO CS2 (cs2-WeaponPaints)
// ==========================================

model WpPlayerSkins {
  steamid               String  @db.VarChar(18)
  weapon_team           Int
  weapon_defindex       Int
  weapon_paint_id       Int
  weapon_wear           Float   @default(0.000001) @db.Float
  weapon_seed           Int     @default(0)
  weapon_nametag        String? @db.VarChar(128)
  weapon_stattrak       Boolean @default(false)
  weapon_stattrak_count Int     @default(0)
  
  // No CS2, os adesivos e chaveiros são salvos como strings formatadas
  weapon_sticker_0      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_1      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_2      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_3      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_sticker_4      String  @default("0;0;0;0;0;0;0") @db.VarChar(128)
  weapon_keychain       String  @default("0;0;0;0;0") @db.VarChar(128)

  // O Prisma exige a chave primária composta que o plugin declarou como UNIQUE KEY
  @@id([steamid, weapon_team, weapon_defindex])
  @@map("wp_player_skins")
}

model WpPlayerKnife {
  steamid     String @db.VarChar(18)
  weapon_team Int
  knife       String @db.VarChar(64)

  @@id([steamid, weapon_team])
  @@map("wp_player_knife")
}

model WpPlayerMusic {
  steamid     String @db.VarChar(64)
  weapon_team Int
  music_id    Int

  @@id([steamid, weapon_team])
  @@map("wp_player_music")
}

model WpPlayerGloves {
  steamid         String @db.VarChar(18)
  weapon_team     Int
  weapon_defindex Int

  @@id([steamid, weapon_team])
  @@map("wp_player_gloves")
}

model WpPlayerAgents {
  steamid  String  @id @db.VarChar(18) 
  agent_ct String? @db.VarChar(64)
  agent_t  String? @db.VarChar(64)

  @@map("wp_player_agents")
}

model WpPlayerPins {
  steamid     String @db.VarChar(64)
  weapon_team Int
  id          Int

  @@id([steamid, weapon_team])
  @@map("wp_player_pins")
}

model StorePlayers {
  id             Int      @id @default(autoincrement())
  SteamID        BigInt   @unique @db.UnsignedBigInt
  PlayerName     String?  @db.VarChar(255)
  Credits        Int
  DateOfJoin     DateTime @db.DateTime(0)
  DateOfLastJoin DateTime @db.DateTime(0)
  Vip            Boolean  

  @@map("store_players")
}

model StoreItems {
  id               Int      @id @default(autoincrement())
  SteamID          BigInt   @db.UnsignedBigInt
  Price            Int      @db.UnsignedInt
  Type             String   @db.VarChar(16)
  UniqueId         String   @db.VarChar(256)
  DateOfPurchase   DateTime @db.DateTime(0)
  DateOfExpiration DateTime @db.DateTime(0)

  @@map("store_items")
}

model StoreEquipments {
  id       Int    @id @default(autoincrement())
  SteamID  BigInt @db.UnsignedBigInt
  Type     String @db.VarChar(16)
  UniqueId String @db.VarChar(256)
  Slot     Int?

  @@map("store_equipments")
}